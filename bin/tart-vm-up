#!/bin/bash
# tart-vm-up -- ensure the mac-gui Tart VM is running and refresh the
# experimental-VNC connection info.
#
# The VM is owned by the launchd agent com.brkd.tart.mac-gui (KeepAlive) which
# runs: tart run mac-gui --vnc-experimental --no-graphics --no-audio
#
# Each tart boot publishes a fresh VNC endpoint (random port + password) in the
# agent log. This script waits for it, verifies it with ONE complete RFB
# handshake (auth through ServerInit -- never a bare banner probe, which can
# destabilize _VZVNCServer), and writes the connection info to
# ~/.config/ghosthands/tart-vnc-current.env for the Ghosthands VNC backend.
#
# Crash note: _VZVNCServer has crashed (SIGTRAP in _VZVirtualMachineAccessor)
# under VNC connection churn. Callers should use ONE persistent RFB connection
# per run, not connect/disconnect per screenshot. If tart restarts, re-run this
# script to refresh the (changed) endpoint.
#
# Idempotent: safe to run any time; reuses the current file when the tart PID
# has not changed. Always refreshes ~/.config/ghosthands/tart-desktop-check.png
# (one screenshot) so an operator can eyeball guest-desktop hygiene before a run.
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

VM="${TART_VM:-mac-gui}"
AGENT="${TART_VM_AGENT:-com.brkd.tart.mac-gui}"
PLIST="$HOME/Library/LaunchAgents/${AGENT}.plist"
LOG="$HOME/Library/Logs/tart-mac-gui.log"
CRED_DIR="$HOME/.config/ghosthands"
CUR="$CRED_DIR/tart-vnc-current.env"
SHOT="$CRED_DIR/tart-desktop-check.png"
mkdir -p "$CRED_DIR"

if [ ! -f "$PLIST" ]; then
  echo "launchd agent not installed: $PLIST" >&2
  exit 1
fi
if ! launchctl list 2>/dev/null | grep -q "$AGENT"; then
  launchctl load "$PLIST"
  echo "loaded $AGENT"
fi

echo -n "waiting for $VM to be running"
for _ in $(seq 1 90); do
  if [ "$(tart list 2>/dev/null | awk -v vm="$VM" '$2==vm {print $NF}')" = "running" ]; then
    echo " -- up"; break
  fi
  echo -n "."; sleep 2
done

# PID of the tart process owning this boot; the VNC endpoint dies with it.
TPID=$(pgrep -f "tart run $VM" | head -1 || true)
[ -n "$TPID" ] || { echo "tart process not found" >&2; exit 1; }

# Resolve the VNC URL: reuse the current file when it belongs to this tart PID,
# otherwise wait for a fresh endpoint in the launchd log.
URL=""
REUSED=0
if [ -f "$CUR" ] && CUR_PID=$(grep -E "^# TART_PID=" "$CUR" | cut -d= -f2) && [ "$CUR_PID" = "$TPID" ]; then
  VNC_HOST=$(grep -E "^VNC_HOST=" "$CUR" | cut -d= -f2)
  VNC_PORT=$(grep -E "^VNC_PORT=" "$CUR" | cut -d= -f2)
  VNC_PASSWORD=$(grep -E "^VNC_PASSWORD=" "$CUR" | cut -d= -f2-)
  URL="vnc://:${VNC_PASSWORD}@${VNC_HOST}:${VNC_PORT}"
  echo "VNC endpoint unchanged (tart pid $TPID); reusing $CUR"
  REUSED=1
else
  echo -n "waiting for VNC endpoint in log"
  for _ in $(seq 1 60); do
    URL=$(grep -oE "vnc://:[^@]+@127\.0\.0\.1:[0-9]+" "$LOG" 2>/dev/null | tail -1 || true)
    if [ -n "$URL" ]; then echo " -- found"; break; fi
    echo -n "."; sleep 2
  done
  [ -n "$URL" ] || { echo; echo "no VNC URL in $LOG" >&2; exit 1; }
fi

# Verify with one COMPLETE RFB handshake (auth + ServerInit), capture one
# desktop screenshot for hygiene, then disconnect.
# A bare banner read leaves a half-open handshake that has coincided with
# _VZVNCServer crashes; always finish what we start.
echo -n "verifying RFB endpoint"
if ! PYTHONPATH="$HOME/Development/ghosthands" python3 - "$URL" "$SHOT" << "PYEOF"; then
import sys, urllib.parse
sys.path.insert(0, "/Users/ericbrookfield/Development/ghosthands")
from ghosthands.vnc import RFBClient
url, shot_path = sys.argv[1], sys.argv[2]
# vnc://:PASSWORD@127.0.0.1:PORT (password may be URL-encoded)
pw = urllib.parse.unquote(url.split("vnc://:")[1].split("@")[0])
hostport = url.split("@")[1]
host, port = hostport.rsplit(":", 1)
r = RFBClient(host, int(port), pw).connect()
print(" RFB OK %dx%d" % (r.width, r.height))
r.save_screenshot(shot_path)
print(" desktop screenshot saved")
r.close()
PYEOF
  echo; echo "RFB verification failed" >&2
  exit 1
fi
chmod 600 "$SHOT"
echo " -- verified (screenshot: $SHOT)"

umask 077
if [ "$REUSED" = "1" ]; then
  echo "VNC ready (reused endpoint, screenshot refreshed)"
  exit 0
fi
PORT=$(echo "$URL" | grep -oE ":[0-9]+$" | tr -d :)
PW=$(echo "$URL" | sed -E 's|vnc://:([^@]+)@.*|\1|')
{
  echo "# Generated by bin/tart-vm-up. Do not commit."
  echo "# TART_PID=$TPID"
  echo "VNC_HOST=127.0.0.1"
  echo "VNC_PORT=$PORT"
  echo "VNC_PASSWORD=$PW"
} > "$CUR"
chmod 600 "$CUR"
echo "VNC ready at 127.0.0.1:$PORT (tart pid $TPID)"
